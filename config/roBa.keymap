#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

// Keep click refresh separate from the key bindings and layer design.

&mkp_input_listener { input-processors = <&zip_temp_layer 4 700>; };

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        JP_NN: JP_NN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &kp N>;
            label = "JP_NN";
        };

        JP_XTU: JP_XTU {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp X &kp T &kp U>;
            label = "JP_XTU";
        };

        exit_AML: exit_AML {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&tog_off 4>;
            label = "EXIT_AML";
        };

        kp_exit_AML: kp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &exit_AML>;
            label = "KP_EXIT_AML";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        nn: nn {
            compatible = "zmk,behavior-hold-tap";
            label = "NN";
            bindings = <&JP_NN>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <125>;
        };

        xtu: xtu {
            compatible = "zmk,behavior-hold-tap";
            label = "XTU";
            bindings = <&JP_XTU>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
        };

        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        mt_exit_AML_on_tap: mt_exit_AML_on_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_EXIT_AML_ON_TAP";
            bindings = <&kp>, <&kp_exit_AML>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp F                             &kp Z         &kp H         &kp P                        &kp MINUS                                                    &kp Q            &kp Y        &lt 5 O  &kp W     &kp V
&kp D                             &kp S         &kp N         &kp T                        &kp G        &kp LEFT_ARROW                 &kp RIGHT_ARROW  &mt BACKSPACE L  &mt MINUS A  &nn 0 I  &xtu 0 U  &mt F7 E
&mt_exit_AML_on_tap LEFT_SHIFT B  &kp R         &kp M         &kp K                        &kp J        &lt_to_layer_0 6 TAB           &to 3            &kp X            &kp COMMA    &kp C    &kp DOT   &mkp LCLK
&kp LCTRL                         &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 6 LEFT_SHIFT  &lt 2 SPACE  &mt LANGUAGE_1 LANGUAGE_2      &kp BACKSPACE    &lt 1 ENTER                                      &lt 5 ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        NUM {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2       &kp NUMBER_3     &kp NUMBER_4  &kp N5                                         &kp NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMBER_0
&kp F7        &kp F8             &kp F9           &kp F10       &kp F11  &kp F12      &kp LS(UNDERSCORE)       &kp APOS      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &mkp MB5
&kp F1        &kp F2             &kp F3           &kp F4        &kp F5   &kp F6       &kp LS(INTERNATIONAL_1)  &kp SLASH     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &mkp MB4
&kp K_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans        &trans   &trans       &trans                   &trans                                                           &mkp RCLK
            >;
        };

        ARROW_JIS {
            bindings = <
&kp LS(NUMBER_1)             &kp LS(NUMBER_8)       &kp LS(NUMBER_9)   &kp EQUAL         &kp LS(EQUAL)                                                &kp CARET           &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp LS(SLASH)                &kp RIGHT_BRACKET      &kp BACKSLASH      &kp LS(NUMBER_2)  &kp LS(NUMBER_6)  &kp LS(LEFT_BRACE)       &kp LS(NUMBER_2)  &kp LEFT_ARROW      &kp DOWN_ARROW     &kp UP_ARROW    &kp RIGHT_ARROW       &kp PERCENT
&mt LEFT_SHIFT LS(NUMBER_5)  &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)  &kp LS(NUMBER_3)  &kp LEFT_BRACKET  &kp INTERNATIONAL_1      &kp UNDERSCORE    &kp LS(UNDERSCORE)  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&kp CAPSLOCK                 &trans                 &kp KP_NUMLOCK     &kp LEFT_SHIFT    &trans            &trans                   &trans            &trans                                                                       &kp PIPE
            >;
        };

        GAME {
            bindings = <
&kp Q             &kp W   &kp E   &kp R    &kp T                           &kp F1          &kp F2          &kp F3        &kp F4           &kp F5
&kp A             &kp S   &kp D   &kp F    &kp G   &kp N           &kp M   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &mkp MB2
&mt LEFT_SHIFT Z  &kp X   &kp C   &kp V    &kp B   &trans          &to 0   &mt N5 N1       &mt N6 N2       &mt N7 N3     &mt N8 N4        &mt N9 N0
&trans            &trans  &trans  &kp TAB  &trans  &kp ESCAPE      &trans  &trans                                                         &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &mkp MB5
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &mkp MB4
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL+EN_ARROW {
            bindings = <
&kp LS(NUMBER_1)             &kp LS(NUMBER_9)    &kp LS(NUMBER_0)     &kp LS(NUMBER_6)  &kp LS(NUMBER_4)                                &kp LC(PAGE_UP)  &kp LS(TAB)     &kp F5          &kp LC(PAGE_DOWN)  &trans
&kp LS(SLASH)                &kp LEFT_BRACE      &kp RIGHT_BRACE      &kp STAR          &kp LS(NUMBER_7)  &kp GRAVE      &kp PAGE_UP    &kp LEFT_ARROW   &kp DOWN_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW    &mkp MB5
&mt LEFT_SHIFT LS(NUMBER_5)  &kp LS(LEFT_BRACE)  &kp LS(RIGHT_BRACE)  &kp LS(NUMBER_3)  &kp LS(NUMBER_2)  &kp SLASH      &kp PAGE_DOWN  &kp TAB          &kp LEFT_ALT    &kp LEFT_SHIFT  &kp LEFT_GUI       &mkp MB4
&trans                       &trans              &trans               &trans            &trans            &trans         &trans         &trans                                                              &trans
            >;
        };

        BLUETOOTH {
            bindings = <
&trans  &trans        &trans        &trans             &trans                                      &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4
&trans  &trans        &trans        &kp LS(LA(LC(R)))  &trans  &kp LS(LA(LC(Q)))      &trans       &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3       &trans  &trans                 &bootloader  &trans         &trans         &trans         &trans         &bt BT_CLR
&trans  &trans        &trans        &trans             &trans  &trans                 &trans       &trans                                                      &bt BT_CLR_ALL
            >;
        };
    };
};
